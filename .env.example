# Copy to .env and fill in. Never commit .env.
# DATABASE_URL accepts postgres://, postgresql:// (as Supabase shows it) or sqlite:///./dev.db
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
POSTGRES_USER=hss
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=hss
# Set COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Only these emails may register (leave [] for open registration on your own laptop)
ALLOWED_EMAILS=[]
# Hosted mode sets STATIC_DIR in the Dockerfile; leave unset locally.

# Market-data keys (optional). Leave blank to keep a provider disabled.
# EODHD: register at https://eodhd.com, copy the API token from your dashboard.
EODHD_API_KEY=
# Free plan = 20 calls/day. Raise this only if your plan allows more (paid plans: 100000).
EODHD_DAILY_CALL_LIMIT=20
# Hours before the app re-checks a stock automatically (manual Refresh ignores this)
AUTO_REFRESH_COOLDOWN_HOURS=6
# EODHD index symbols. NGX ASI left blank until you confirm its code with a provider
# search (type = index) on your own key.
INDEX_SYMBOLS={"NGXASI":"","SPX":"GSPC.INDX","IXIC":"IXIC.INDX"}
FMP_API_KEY=
TWELVEDATA_API_KEY=
NGX_API_KEY=
